    "nint.config.example.json",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "test": "node --test tests/core.node.mjs tests/cli.node.mjs tests/session.node.mjs"
  },
  "dependencies": {
    "playwright": "1.63.0"
  },
